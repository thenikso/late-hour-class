{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "allowJs": true
  },
  "include": [
    "server.js",
    "lib/**/*.js",
    "public/js/**/*.js",
    "tools/**/*.js",
    "test/**/*.js"
  ],
  "exclude": [
    "public/vendor/**",
    "data/**"
  ]
}
